{
	"$schema": "https://json-schema.org/draft-07/schema",
	"name": "agente_implementador",
	"description": "Agente que implementa issues do JIRA e realiza commits e PRs no respositório do Azure DevOps",
	"version": "0.0.1",
	"license": "MIT",
	"icon": "./plugins/engenharia/agente_implementador/assets/icon.png",
	"author": "Engenharia V&D",
	"keywords": [
			"poui",
			"Engenharia-ved",
			"v&D",
			"engenharia-v&d",
			"Agents-poui",
			"protheus-poui"
		],
	"skills": [
			"./plugins/engenharia/agente_implementador/skills/ai-assisted-jira-flow",
			"./plugins/engenharia/agente_implementador/skills/jira-attached-plan-flow",
			"./plugins/engenharia/agente_implementador/skills/pr-validation-jira-azure-flow",
			"./plugins/engenharia/agente_implementador/skills/superpowers"
			],
	"agents": [
			"./plugins/engenharia/agente_implementador/agents/jira-context-researcher.agent.md",
			"./plugins/engenharia/agente_implementador/agents/jira-delivery-scribe.agent.md",
			"./plugins/engenharia/agente_implementador/agents/jira-flow.agent.md"
			],
	"mcpServers": {
			"jira": {
				"type": "http",
				"url": "http://localhost:8000/mcp",
				"headers": {
					"Authorization": "Bearer uCdXsz3ZPEcpSGgv2LnAIxEknwATaliiCiA-rOK3szI"
				}
			},
			"azure-devops-local": {
				"type": "stdio",
				"command": "npx",
				"args": [
						"-y",
						"@azure-devops/mcp",
						"${input:ado_org}",
						"-d",
						"core",
						"repositories",
						"pipelines",
						"-a",
						"azcli"
					]
			}
			},
		"hooks": {},
		"repository": "https://github.com/everson-junior/engenharia-ved-plugins"
}