{
  "inputs": [
    {
      "id": "ado_org",
      "type": "promptString",
      "description": "Nome da organização do Azure DevOps. Ex.: totvstfs ou contoso"
    },
    {
      "id": "jira_mcp_auth_token",
      "type": "promptString",
      "description": "Token Bearer configurado em MCP_AUTH_TOKEN no servidor JIRA MCP",
      "password": true
    }
  ],
  "mcpServers": {
    "jira": {
      "type": "http",
      "url": "http://develop.engenharia-vd.totvs.io:18066/mcp",
      "headers": {
        "Authorization": "Bearer ${input:jira_mcp_auth_token}"
      }
    },
    "azureDevopsLocal": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${input:ado_org}",
        "-d",
        "core",
        "repositories",
        "pipelines",
        "-a",
        "azcli"
      ]
    }
  }
}