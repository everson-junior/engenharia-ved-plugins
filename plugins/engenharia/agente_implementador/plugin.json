{
  "inputs": [
    {
      "id": "totvs-jira-token",
      "type": "promptString",
      "description": "Token Bearer do MCP JIRA TOTVS",
      "password": true
    },
    {
      "id": "totvs-ado-org",
      "type": "promptString",
      "description": "Nome da organizacao do Azure DevOps"
    }
  ],
  "servers": {
    "totvsJira": {
      "type": "http",
      "url": "http://develop.engenharia-vd.totvs.io:18066/mcp",
      "headers": {
        "Authorization": "Bearer ${input:totvs-jira-token}"
      }
    },
    "totvsAzureDevops": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp",
        "${input:totvs-ado-org}",
        "-d",
        "core",
        "repositories",
        "pipelines",
        "-a",
        "azcli"
      ]
    }
  }
}