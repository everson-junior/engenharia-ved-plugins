# JIRA API TOTVS - Environment Variables Template
# Copy this file to .env and fill with your credentials

# JIRA Base URL (Production)
JIRA_BASE_URL=https://jiraproducao.totvs.com.br/rest/api/2

# Basic Auth Credentials
# IMPORTANT: Use username WITHOUT @totvs.com.br
# ✅ Correct: joao.santillo
# ❌ Wrong: joao.santillo@totvs.com.br
JIRA_USERNAME=your_username
JIRA_PASSWORD=your_password

# Optional: Bearer Token (if using token auth instead of Basic Auth)
# JIRA_BEARER_TOKEN=your_api_token_here

# Optional: Auth Type (basic or bearer)
# JIRA_AUTH_TYPE=basic
